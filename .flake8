[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    */migrations/*,
    venv,
    .venv,
    staticfiles,
    media,
    *.pyc,
    .env
extend-ignore =
    E203,  # whitespace before ':' (conflicts with black)
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator (conflicts with black)
per-file-ignores =
    __init__.py:F401
    settings/*.py:E501,F405,F403
max-complexity = 10
