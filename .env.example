# Django settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,overnight.flyhomemnlab.com,overnight.home.arpa

# Database (External PostgreSQL)
# Use the dedicated OvernightApp database and user
DATABASE_NAME=overnight_app
DATABASE_USER=overnight_user
DATABASE_PASSWORD=OvernightApp2026!SecurePass  # Change this in production!
DATABASE_HOST=hercules
DATABASE_PORT=5432

# Cloudflare R2 Storage
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=your-cdn-domain.com
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Redis (for caching)
REDIS_URL=redis://redis:6379/0

# Email (optional, for password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
